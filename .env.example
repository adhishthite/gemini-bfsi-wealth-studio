# ============================================================================
# Cymbal Direct — Style Studio configuration
# Copy to `.env` and edit.  cp .env.example .env
# Auth is Google ADC (no keys here): run `gcloud auth application-default login`
# or rely on the attached service account on a GCP VM / Cloud Run.
# ============================================================================

# ---- Default project / region (fallback for every capability below) ----
GCP_PROJECT=your-gcp-project
GCP_LOCATION=us-central1

# ---- Conversational brain (standard Gemini on Vertex) ----
# Leave blank to inherit GCP_PROJECT / GCP_LOCATION.
BRAIN_PROJECT=
BRAIN_LOCATION=global
BRAIN_MODEL=gemini-3.5-flash-lite

# ---- Imagery (build-time catalog) + Virtual Try-On (runtime) ----
IMAGE_PROJECT=
IMAGE_LOCATION=global
IMAGE_MODEL=gemini-3-pro-image
VTO_MODEL=gemini-3.1-flash-image

# ---- Live Avatar (Gemini 3.1 Live API, Private Preview) ----
# Transport: fallback (default; portrait + standard brain, no Live API)
#          | live  (real video avatar via raw Vertex BidiGenerateContent proxy)
AVATAR_TRANSPORT=live
#
# LIVE_PROJECT must be ALLOWLISTED for the Live Avatar Private Preview (your allowlisted project), and your
# ADC identity must have Vertex AI User on it (`aiplatform.endpoints.predict`).
LIVE_PROJECT=your-allowlisted-project
LIVE_LOCATION=us-central1
LIVE_MODEL=gemini-3.1-flash-live-preview-04-2026
AVATAR_NAME=Kira       # built-in: Jay, Paul, Sam, Ingrid, Kira, Vera, Ben, Kai, Leo, Carmen, Piper
AVATAR_VOICE=Aoede     # Puck, Aoede, Charon, Kore, Fenrir, Zephyr

# ---- App ----
STYLIST_NAME=Aria
PORT=8000
